<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;pg_embed/**;docs/**;sql/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="MysticMind.PostgresEmbed" Version="5.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Data/Sql/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
