<mxfile host="app.diagrams.net"><diagram name="Diario" id="diario"><mxGraphModel page="1" pageWidth="1200" pageHeight="740" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="TecnoNova | Bosquejo Diario" style="text;html=1;align=left;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="12" width="1136" height="48" /></mxCell><mxCell id="band0" value="&lt;b&gt;HEADER / Encabezado&lt;/b&gt;&lt;br/&gt;&lt;b&gt;TN TecnoNova | Reporte diario de ventas&lt;/b&gt;&lt;br/&gt;Rango: @inicio / @fin · emisión: DateTime.Now · operador: generadoPor&lt;br/&gt;Logo y título: aplicación. Operador: dato ingresado; no existe tabla de usuarios." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#ffffff;strokeColor=#16566c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="80" width="1136" height="112" /></mxCell><mxCell id="band1" value="&lt;b&gt;GROUP HEADER / Encabezado de grupo&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Día 2026-11-24&lt;/b&gt;&lt;br/&gt;TO_CHAR(ventas.fecha, &amp;#x27;YYYY-MM-DD&amp;#x27;)&lt;br/&gt;Una banda por cada día del periodo." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#ffffff;strokeColor=#16566c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="206" width="1136" height="112" /></mxCell><mxCell id="band2" value="&lt;b&gt;DETAIL / Detalle&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Nro. | Hora | Cliente | Vendedor | Bruto | Descuento | Total&lt;/b&gt;&lt;br/&gt;ventas.id | ventas.fecha | ventas.cliente | ventas.vendedor&lt;br/&gt;ventas.subtotal_bruto | ventas.monto_descuento | ventas.total_final" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#ffffff;strokeColor=#16566c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="332" width="1136" height="112" /></mxCell><mxCell id="band3" value="&lt;b&gt;GROUP FOOTER / Pie de grupo&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Subtotal del día · Operaciones · Bruto · Descuentos · Cobrado&lt;/b&gt;&lt;br/&gt;COUNT(ventas.id) · SUM(ventas.subtotal_bruto)&lt;br/&gt;SUM(ventas.monto_descuento) · SUM(ventas.total_final)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#ffffff;strokeColor=#16566c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="458" width="1136" height="112" /></mxCell><mxCell id="band4" value="&lt;b&gt;REPORT FOOTER / Pie del reporte&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Gran total del periodo · operaciones · descuentos · Página X de Y&lt;/b&gt;&lt;br/&gt;Suma de todos los grupos, sin duplicar ventas.&lt;br/&gt;Página X de Y: calculada por ReporteVentas.Paginas()." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#ffffff;strokeColor=#16566c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="584" width="1136" height="112" /></mxCell></root></mxGraphModel></diagram><diagram name="Mensual" id="mensual"><mxGraphModel page="1" pageWidth="1200" pageHeight="740" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="TecnoNova | Bosquejo Mensual" style="text;html=1;align=left;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="12" width="1136" height="48" /></mxCell><mxCell id="band0" value="&lt;b&gt;HEADER / Encabezado&lt;/b&gt;&lt;br/&gt;&lt;b&gt;TN TecnoNova | Reporte mensual de ventas&lt;/b&gt;&lt;br/&gt;Rango: @inicio / @fin · emisión: DateTime.Now · operador: generadoPor&lt;br/&gt;Logo y título: aplicación. Operador: dato ingresado; no existe tabla de usuarios." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#ffffff;strokeColor=#16566c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="80" width="1136" height="112" /></mxCell><mxCell id="band1" value="&lt;b&gt;GROUP HEADER / Encabezado de grupo&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Mes 2026-10 / Mes 2026-11&lt;/b&gt;&lt;br/&gt;TO_CHAR(ventas.fecha, &amp;#x27;YYYY-MM&amp;#x27;)&lt;br/&gt;Una banda por cada mes del periodo." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#ffffff;strokeColor=#16566c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="206" width="1136" height="112" /></mxCell><mxCell id="band2" value="&lt;b&gt;DETAIL / Detalle consolidado&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Fecha del día | Operaciones | Bruto | Descuento | Cobrado&lt;/b&gt;&lt;br/&gt;ventas.fecha::date | COUNT(ventas.id) | SUM(ventas.subtotal_bruto)&lt;br/&gt;SUM(ventas.monto_descuento) | SUM(ventas.total_final) · agrupado por fecha" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#ffffff;strokeColor=#16566c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="332" width="1136" height="112" /></mxCell><mxCell id="band3" value="&lt;b&gt;GROUP FOOTER / Pie de grupo&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Subtotal mensual · Operaciones · Bruto · Descuentos · Cobrado&lt;/b&gt;&lt;br/&gt;Suma de los valores diarios del mismo mes.&lt;br/&gt;COUNT(ventas.id) y SUM de los importes, sin duplicar transacciones." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#ffffff;strokeColor=#16566c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="458" width="1136" height="112" /></mxCell><mxCell id="band4" value="&lt;b&gt;REPORT FOOTER / Pie del reporte&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Gran total de todos los meses · Página X de Y&lt;/b&gt;&lt;br/&gt;Suma de los subtotales mensuales; no se suman detalles de productos.&lt;br/&gt;Página X de Y: calculada por ReporteVentas.Paginas()." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#ffffff;strokeColor=#16566c;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="584" width="1136" height="112" /></mxCell></root></mxGraphModel></diagram></mxfile>