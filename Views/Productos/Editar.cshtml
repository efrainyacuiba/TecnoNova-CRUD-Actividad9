@model Producto
@{ ViewData["Title"] = "Editar producto"; }
<div class="page-head"><div><span class="eyebrow neon">EDICIÓN / A9</span><h1>Editar producto</h1><p>Modificar un producto existente sin cambiar su historial de ventas.</p></div></div>
<div class="panel narrow"><form asp-action="Editar" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id"/>
<label>Código *<input asp-for="Codigo" required maxlength="30" /></label>
<label>Nombre *<input asp-for="Nombre" required maxlength="100" /></label>
<div class="form-row"><label>Precio (Bs) *<input type="number" asp-for="Precio" min="0.01" step="0.01" required /></label><label>Stock *<input type="number" asp-for="Stock" min="0" required /></label></div>
<div class="form-actions"><button type="submit" class="btn primary">Guardar cambios</button><a class="btn secondary" asp-action="Index">Cancelar</a></div>
</form></div>
