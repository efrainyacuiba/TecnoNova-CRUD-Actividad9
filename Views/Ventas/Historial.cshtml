@model List<VentaResumen>
@{ ViewData["Title"] = "Historial de ventas"; }
<div class="page-head"><div><span class="eyebrow neon">TRAZABILIDAD / A7 + A8</span><h1>Historial de ventas</h1><p>Consulta vendedor, subtotal bruto, porcentaje aplicado y monto final.</p></div></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Venta</th><th>Fecha</th><th>Cliente</th><th>Vendedor</th><th>Bruto</th><th>Dto.</th><th>Descuento</th><th>Total</th></tr></thead><tbody>
@foreach (var v in Model) { <tr><td class="code">#@v.Id</td><td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@v.Cliente</td><td>@v.Vendedor</td><td>Bs @v.SubtotalBruto.ToString("N2")</td><td>@v.PorcentajeDescuento.ToString("N2")%</td><td>Bs @v.MontoDescuento.ToString("N2")</td><td><strong>Bs @v.TotalFinal.ToString("N2")</strong></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="8" class="empty">Todavía no hay ventas registradas.</td></tr> }
</tbody></table></div></section>
